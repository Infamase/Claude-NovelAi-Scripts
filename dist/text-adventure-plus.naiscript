              storageKey: `story:${key("role")}`,
              onChange: edited,
              style: { flex: "1 1 12em" }
            },
            { type: "checkboxInput", label: "In party", storageKey: `story:${key("present")}`, onChange: edited }
          ]
        },
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Status", storageKey: `story:${key("status")}`, onChange: edited, style: { width: "12em" } },
            ...presets("status", STATUS_PRESETS)
          ]
        },
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Attitude toward you", storageKey: `story:${key("attitude")}`, onChange: edited, style: { width: "12em" } },
            ...presets("attitude", ATTITUDE_PRESETS)
          ]
        },
        {
          type: "textInput",
          label: "Notes",
          placeholder: "Personality, goals, secrets (optional)",
          storageKey: `story:${key("notes")}`,
          onChange: edited
        },
        {
          type: "row",
          spacing: "start",
          content: [
            {
              type: "button",
              text: "Move up",
              iconId: "arrow-up",
              disabled: index === 0,
              callback: () => moveMember(member.id, -1).then(rebuild2).catch(logError)
            },
            {
              type: "button",
              text: "Move down",
              iconId: "arrow-down",
              disabled: index === total - 1,
              callback: () => moveMember(member.id, 1).then(rebuild2).catch(logError)
            },
            {
              type: "button",
              text: "Remove",
              iconId: "trash-2",
              callback: () => removeMember(member.id).then(rebuild2).catch(logError)
            }
          ]
        }
      ]
    };
  }
  async function updatePartyPreview(party) {
    const current = party ?? await readParty();
    const block = gameStateBlock(partyLines(current));
    const text2 = !current.share ? "Nothing: sending the party is turned off above." : block ?? "Nothing yet. Add a companion with a name, and they will be sent with every turn.";
    await api.v1.storyStorage.set(PARTY.preview, forTemplate(text2));
  }

  // src/ui/storyPanels.ts
  var visible = false;
  async function setStoryPanelsVisible(show) {
    if (show === visible) return;
    if (show) await api.v1.ui.update(await storyPanels());
    else await api.v1.ui.remove([IDS.partyPanel, IDS.inventoryPanel]);
    visible = show;
  }
  async function rebuild() {
    if (visible) await api.v1.ui.update(await storyPanels());
  }
  async function storyPanels() {
    return [await partyPanel(rebuild), await inventoryPanel(rebuild)];
  }

  // src/ui/settingsPanel.ts
  async function registerSettingsPanel() {
    await api.v1.ui.register([
      {
        type: "sidebarPanel",
        id: IDS.settingsPanel,
        name: "Text Adventure+",
        iconId: "compass",
        content: [
          {
            type: "text",
            markdown: true,
            text: `**Text Adventure+** v${api.v1.script.version}`
          },
          {
            type: "checkboxInput",
            label: "Enable for this story",
            storageKey: `story:${KEYS.enabled}`,
            onChange: (on) => {
              setStoryPanelsVisible(on).catch(logError);
            }
          },
          {
            type: "text",
            text: "When enabled, the AI stops at your turn, and Party and Inventory tabs appear above the bottom controls.",
            style: { opacity: 0.7 }
          },
          {
            type: "checkboxInput",
            label: "Referee: double-check each reply with a quick AI call",
            storageKey: KEYS.referee
          },
          {
            type: "checkboxInput",
            label: "Strict: no physical reactions from your character either",
            storageKey: KEYS.strict
          },
          {
            type: "collapsibleSection",
            title: "Last turn",
            iconId: "activity",
            content: [
              {
                type: "text",
                text: `{{story:${KEYS.lastTurnStatus}}}`,
                style: { whiteSpace: "pre-wrap", fontSize: "0.9em" }
              },
              {
                type: "button",
                text: "Copy details",
                iconId: "copy",
                callback: () => copyDetails().catch(logError)
              },
              {
                type: "text",
                text: "If a turn was cut wrongly, or should have been cut, copy its details and send them to Claude.",
                style: { opacity: 0.7, fontSize: "0.85em" }
              }
            ]
          },
          {
            type: "collapsibleSection",
            title: "Referee check",
            iconId: "check-circle",
            initialCollapsed: true,
            content: [
              {
                type: "text",
                text: "Runs the referee once on a made-up turn, outside any reply, to check that it can reach the AI.",
                style: { opacity: 0.7, fontSize: "0.85em" }
              },
              {
                type: "button",
                text: "Test the referee",
                iconId: "play",
                disabledWhileCallbackRunning: true,
                callback: () => runRefereeTest().then((result) => api.v1.ui.toast(result, { type: result.includes("passed") ? "success" : "warning" })).catch(logError)
              },
              {
                type: "text",
                text: `{{story:${KEYS.refereeTest}}}`,
                style: { whiteSpace: "pre-wrap", fontSize: "0.9em" }
              }
            ]
          }
        ]
      }
    ]);
  }
  async function copyDetails() {
    const details = await api.v1.storyStorage.get(KEYS.lastTurnDetails);
    if (!details) {
      await api.v1.ui.toast("No turn has been checked in this story yet.", { type: "info" });
      return;
    }
    const granted = await api.v1.permissions.request(
      "clipboardWrite",
      "Text Adventure+ needs clipboard access to copy the last turn's details."
    );
    if (!granted) return;
    await api.v1.clipboard.writeText(String(details));
    await api.v1.ui.toast("Details copied.", { type: "success" });
  }

  // src/main.ts
  async function init() {
    await api.v1.storage.setIfAbsent(KEYS.referee, true);
    await api.v1.storyStorage.setIfAbsent(KEYS.lastTurnStatus, "No turn checked yet.");
    await api.v1.storyStorage.setIfAbsent(KEYS.refereeTest, "Not run yet.");
    for (const key of OLD_STORY_KEYS) await api.v1.storyStorage.remove(key);
    await initInventory();
    await initParty();
    await registerSettingsPanel();
    const enabled = await api.v1.storyStorage.get(KEYS.enabled) === true;
    await setStoryPanelsVisible(enabled);
    api.v1.log(`Text Adventure+ v${api.v1.script.version} loaded (enabled for this story: ${enabled})`);
  }
  registerTurnGuard();
  init().catch(logError);
})();
