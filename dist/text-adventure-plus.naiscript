    }
    return `UNKNOWN: unexpected text after the early part: ${quote(after, 120)}`;
  }
  function formatReport(r, verdict, documentTail) {
    const yesNo = (value) => value ? "yes" : "no";
    const ta = r.taInput;
    const lines = [
      `Text Adventure+ stop test (v${api.v1.script.version})`,
