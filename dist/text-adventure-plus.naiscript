  }
  function statusText(d, turn) {
    if (!d.reply.trim()) return "Last turn: the AI wrote nothing.";
    const total = d.sentences.length - d.lead;
    const kept = d.sentences.filter((s, i) => i >= d.lead && s.start < d.keep).length;
    const lines = [];
    if (d.cut) {
      const sentence = quote(d.sentences[d.cut.index].text.trim(), 120);
      lines.push(
        kept === 0 ? `Last turn: nothing was kept. The reply started by writing for your character: ${sentence}` : `Last turn: kept ${kept} of ${total} sentences. Cut from: ${sentence}`,
        `Why: ${d.cut.reason} (found by the ${d.cut.by === "referee" ? "referee" : "pattern rules"}).`
      );
      if (kept === 0 && turn?.retryNumber !== void 0) {
        lines.push(`Asking the AI again automatically (${turn.retryNumber} of ${MAX_AUTO_RETRIES}).`);
      }
    } else if (total === 0) {
      lines.push("Last turn: nothing was kept. The reply was only scene breaks or headings.");
    } else if (d.unfinishedTrimmed) {
      lines.push(`Last turn: kept ${kept} of ${total} sentences, minus an unfinished last sentence.`);
    } else {
      lines.push(`Last turn: nothing to cut (${total} sentence${total === 1 ? "" : "s"}).`);
    }
    if (d.lead > 0 && total > 0) lines.push("Removed a scene break or heading from the start.");
    if (d.referee) {
      const seconds = `${(d.referee.ms / 1e3).toFixed(1)} s`;
      lines.push(
        d.referee.error ? `Referee: unavailable (${d.referee.error}), so the pattern rules checked for actions too.` : `Referee: ${d.referee.answer ? `flagged sentence ${d.referee.answer}` : "no problems"} (${d.referee.model}, ${seconds}).`
      );
    }
    return lines.join("\n");
  }
  function detailsText(turn, d) {
    const marks = d.sentences.map((s, i) => {
      const mark = i < d.lead ? "–" : s.start < d.keep ? "✓" : d.cut?.index === i ? "✂" : "·";
      return `  ${i + 1} ${mark} ${quote(s.text.trim(), 400)}`;
    });
    return [
      `Text Adventure+ last turn (v${api.v1.script.version})`,
      `Model: ${turn.model} | strict: ${turn.strict ? "on" : "off"} | referee: ${turn.referee ? "on" : "off"}`,
      `Player input: ${turn.playerInput === void 0 ? "(none)" : quote(turn.playerInput, 400)}`,
      statusText(d, turn),
      d.referee ? `Referee answer: ${quote(d.referee.raw, 40)}${d.referee.failedFirst ? ` (after ${d.referee.failedFirst})` : ""}` : "Referee: not asked",
      "Reply, sentence by sentence (✓ kept, ✂ cut here, · hidden, – removed):",
      ...marks,
      `Story just before: ${quote(turn.storyTail ?? "", 400)}`
    ].join("\n");
  }
  var REFEREE_SAMPLE = {
    storyTail: 'The dragon opens one violet eye. "Awake, are we?"',
    playerInput: 'You ask "Who are you?"',
    sentences: ["The dragon lifts her head from the pile of books.", '"Where am I?" you whisper.', "She laughs, a sound like rolling thunder."],
    strict: false
  };
  async function runRefereeTest() {
    const settings = await api.v1.generationParameters.get().catch(() => void 0);
    const result = await askReferee(settings?.model ?? "glm-4-6", REFEREE_SAMPLE);
    const where = `${result.model}, ${(result.ms / 1e3).toFixed(1)} s`;
    const text = result.error ? `Referee test failed: ${result.error}` : result.answer === 2 ? `Referee test passed: it found the right sentence (${where}).` : `Referee test: it works, but answered ${result.answer} where 2 was right (${where}).`;
    await api.v1.storyStorage.set(KEYS.refereeTest, sanitize(text));
    return text;
  }
  async function isEnabled() {
    return await api.v1.storyStorage.get(KEYS.enabled) === true;
  }
  async function readSettings() {
    return {
      strict: await api.v1.storage.get(KEYS.strict) === true,
      referee: await api.v1.storage.get(KEYS.referee) !== false
    };
  }
  async function settingsFor(continuityId, dryRun) {
    const turn = turns.get(continuityId);
    if (turn) return turn;
    if (dryRun && await isEnabled()) return readSettings();
    return void 0;
  }
  async function addedTokenCount(model, strict) {
    const key = `${model}|${strict}`;
    let count = addedTokens.get(key);
    if (count === void 0) {
      const text = addedText(strict);
      count = await api.v1.tokenizer.encode(text, model).then((tokens) => tokens.length).catch(() => Math.ceil(text.length / 3));
      addedTokens.set(key, count);
    }
    return count + 8;
  }
  function quote(text, max) {
    return JSON.stringify(text.length > max ? text.slice(0, max) + "…" : text);
  }
  function sanitize(text) {
    return text.replace(/\{\{/g, "{ {");
  }

  // src/ui/storyPanels.ts
  var visible = false;
  async function setStoryPanelsVisible(show) {
    if (show === visible) return;
    if (show) await api.v1.ui.update([partyPanel(), inventoryPanel()]);
    else await api.v1.ui.remove([IDS.partyPanel, IDS.inventoryPanel]);
    visible = show;
  }
  function partyPanel() {
    return {
      type: "scriptPanel",
      id: IDS.partyPanel,
      name: "Party",
      iconId: "users",
      content: [
        {
          type: "text",
          markdown: true,
          text: [
            "**Party** (coming in Phase 3)",
            "",
            "Your companions will be listed here with their role, status (healthy, wounded…), attitude toward you and notes. Members marked *in party* are added to the AI's context every turn, like this:",
            "",
            "`[ Party: Lyra (elf ranger; wounded; trusts you) ]`"
          ].join("\n")
        }
      ]
    };
  }
  function inventoryPanel() {
    return {
      type: "scriptPanel",
      id: IDS.inventoryPanel,
      name: "Inventory",
      iconId: "package",
      content: [
        {
          type: "text",
          markdown: true,
          text: [
            "**Inventory** (coming in Phase 2)",
            "",
            "Your currency, items with quantities, and what you have equipped will be tracked here and added to the AI's context every turn, like this:",
            "",
            "`[ Equipped: iron sword ]`  ",
            "`[ Carrying: healing potion ×3, rope; 45 gold ]`"
          ].join("\n")
        }
      ]
    };
  }

  // src/ui/settingsPanel.ts
  async function registerSettingsPanel() {
    await api.v1.ui.register([
      {
        type: "sidebarPanel",
        id: IDS.settingsPanel,
        name: "Text Adventure+",
        iconId: "compass",
        content: [
          {
            type: "text",
            markdown: true,
            text: `**Text Adventure+** v${api.v1.script.version}`
          },
          {
            type: "checkboxInput",
            label: "Enable for this story",
            storageKey: `story:${KEYS.enabled}`,
            onChange: (on) => {
              setStoryPanelsVisible(on).catch(logError);
            }
          },
          {
            type: "text",
            text: "When enabled, the AI stops at your turn, and Party and Inventory tabs appear above the bottom controls.",
            style: { opacity: 0.7 }
          },
          {
            type: "checkboxInput",
            label: "Referee: double-check each reply with a quick AI call",
            storageKey: KEYS.referee
          },
          {
            type: "checkboxInput",
            label: "Strict: no physical reactions from your character either",
            storageKey: KEYS.strict
          },
          {
            type: "collapsibleSection",
            title: "Last turn",
            iconId: "activity",
            content: [
              {
                type: "text",
                text: `{{story:${KEYS.lastTurnStatus}}}`,
                style: { whiteSpace: "pre-wrap", fontSize: "0.9em" }
              },
              {
                type: "button",
                text: "Copy details",
                iconId: "copy",
                callback: () => copyDetails().catch(logError)
              },
              {
                type: "text",
                text: "If a turn was cut wrongly, or should have been cut, copy its details and send them to Claude.",
                style: { opacity: 0.7, fontSize: "0.85em" }
              }
            ]
          },
          {
            type: "collapsibleSection",
            title: "Referee check",
            iconId: "check-circle",
            initialCollapsed: true,
            content: [
              {
                type: "text",
                text: "Runs the referee once on a made-up turn, outside any reply, to check that it can reach the AI.",
                style: { opacity: 0.7, fontSize: "0.85em" }
              },
              {
                type: "button",
                text: "Test the referee",
                iconId: "play",
                disabledWhileCallbackRunning: true,
                callback: () => runRefereeTest().then((result) => api.v1.ui.toast(result, { type: result.includes("passed") ? "success" : "warning" })).catch(logError)
              },
              {
                type: "text",
                text: `{{story:${KEYS.refereeTest}}}`,
                style: { whiteSpace: "pre-wrap", fontSize: "0.9em" }
              }
            ]
          }
        ]
      }
    ]);
  }
  async function copyDetails() {
    const details = await api.v1.storyStorage.get(KEYS.lastTurnDetails);
    if (!details) {
      await api.v1.ui.toast("No turn has been checked in this story yet.", { type: "info" });
      return;
    }
    const granted = await api.v1.permissions.request(
      "clipboardWrite",
      "Text Adventure+ needs clipboard access to copy the last turn's details."
    );
    if (!granted) return;
    await api.v1.clipboard.writeText(String(details));
    await api.v1.ui.toast("Details copied.", { type: "success" });
  }

  // src/main.ts
  async function init() {
    await api.v1.storage.setIfAbsent(KEYS.referee, true);
    await api.v1.storyStorage.setIfAbsent(KEYS.lastTurnStatus, "No turn checked yet.");
    await api.v1.storyStorage.setIfAbsent(KEYS.refereeTest, "Not run yet.");
    for (const key of OLD_STORY_KEYS) await api.v1.storyStorage.remove(key);
    await registerSettingsPanel();
    const enabled = await api.v1.storyStorage.get(KEYS.enabled) === true;
    await setStoryPanelsVisible(enabled);
    api.v1.log(`Text Adventure+ v${api.v1.script.version} loaded (enabled for this story: ${enabled})`);
  }
  registerTurnGuard();
  init().catch(logError);
})();
