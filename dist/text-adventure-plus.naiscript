      ta ? `TA input: ${ta.mode} | input ${quote(ta.inputText, 80)} | raw ${quote(ta.rawInputText, 80)} | same turn: ${yesNo(ta.continuityId === r.continuityId)}` : "TA input: none recorded",
      "",
