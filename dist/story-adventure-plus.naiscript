/*---
compatibilityVersion: naiscript-1.0
id: 49fb05e0-8e3c-4f0e-a7f0-eaea528b70c5
name: Story Adventure+
createdAt: 1792084608383
updatedAt: 1792090415163
version: 0.2.0
author: Infamase
description: Keeps Story mode in second person, present tense with a writing guide against AI cliches, and adds Setting, Player, Party and Inventory tabs that feed the story context.
memoryLimit: 8
---*/
"use strict";
(() => {
  // src/keys.ts
  var IDS = {
    settingsPanel: "tap-settings",
    settingPanel: "tap-setting",
    playerPanel: "tap-player",
    partyPanel: "tap-party",
    inventoryPanel: "tap-inventory"
  };
  function logError(error) {
    api.v1.error(`${api.v1.script.name}:`, error);
  }

  // src/state/store.ts
  function text(value) {
    return typeof value === "string" ? value : value == null ? "" : String(value);
  }
  function count(value, fallback) {
    if (value === "" || value == null) return fallback;
    const n = Number(value);
    return Number.isFinite(n) ? Math.max(0, Math.floor(n)) : fallback;
  }
  async function idList(key) {
    const ids = await api.v1.storyStorage.get(key);
    return Array.isArray(ids) ? ids.filter((id) => typeof id === "string") : [];
  }
  async function moveInList(key, id, delta) {
    const ids = await idList(key);
    const from = ids.indexOf(id);
    const to = from + delta;
    if (from < 0 || to < 0 || to >= ids.length) return;
    [ids[from], ids[to]] = [ids[to], ids[from]];
    await api.v1.storyStorage.set(key, ids);
  }

  // src/state/inventory.ts
  var INV = {
    share: "tap.inv.share",
    currency: "tap.inv.currency",
    amount: "tap.inv.amount",
    prices: "tap.inv.prices",
    /** The item ids, in the order shown. */
    items: "tap.inv.items",
    /** What the AI sees, for the tab's preview. */
    preview: "tap.inv.preview",
    item: (id, field) => `tap.inv.item.${id}.${field}`
  };
  var DEFAULT_PRICES = [
    "bread or a mug of ale: 1",
    "a hot meal: 2",
    "a night at an inn: 5",
    "a rug or simple tools: 30",
    "a sword: 50",
    "a horse: 300"
  ].join("\n");
  var ITEM_FIELDS = ["name", "quantity", "equipped", "note"];
  async function initInventory() {
    const s = api.v1.storyStorage;
    await s.setIfAbsent(INV.share, true);
    await s.setIfAbsent(INV.currency, "gold");
    await s.setIfAbsent(INV.amount, 0);
    await s.setIfAbsent(INV.prices, DEFAULT_PRICES);
    await s.setIfAbsent(INV.items, []);
  }
  async function readInventory() {
    const s = api.v1.storyStorage;
    const items = await Promise.all(
      (await itemIds()).map(async (id) => ({
        id,
        name: text(await s.get(INV.item(id, "name"))),
        quantity: count(await s.get(INV.item(id, "quantity")), 1),
        equipped: await s.get(INV.item(id, "equipped")) === true,
        note: text(await s.get(INV.item(id, "note")))
      }))
    );
    return {
      share: await s.get(INV.share) !== false,
      currency: text(await s.get(INV.currency)).trim() || "gold",
      amount: count(await s.get(INV.amount), 0),
      prices: text(await s.get(INV.prices)),
      items
    };
  }
  async function addItem() {
    const id = api.v1.uuid();
    const s = api.v1.storyStorage;
    await s.set(INV.item(id, "name"), "");
    await s.set(INV.item(id, "quantity"), 1);
    await s.set(INV.item(id, "equipped"), false);
    await s.set(INV.item(id, "note"), "");
    await s.set(INV.items, [...await itemIds(), id]);
    return id;
  }
  async function removeItem(id) {
    const s = api.v1.storyStorage;
    await s.set(INV.items, (await itemIds()).filter((other) => other !== id));
    for (const field of ITEM_FIELDS) await s.remove(INV.item(id, field));
  }
  async function adjustCount(key, delta, fallback = 0) {
    const s = api.v1.storyStorage;
    await s.set(key, Math.max(0, count(await s.get(key), fallback) + delta));
  }
  function inventoryLines(inv) {
    const items = inv.items.filter((item) => item.name.trim() !== "" && item.quantity > 0);
    if (!inv.share || inv.amount === 0 && items.length === 0) return [];
    const lines = [`Money: ${inv.amount} ${inv.currency}.`];
    const prices = priceList(inv.prices);
    if (prices) lines.push(`Typical prices in ${inv.currency}: ${prices}. Keep every price in the story in line with these.`);
    const named = (item) => item.quantity > 1 ? `${item.name.trim()} ×${item.quantity}` : item.name.trim();
    const equipped = items.filter((item) => item.equipped);
    const carried = items.filter((item) => !item.equipped);
    if (equipped.length > 0) {
      lines.push(`Equipped: ${equipped.map((item) => item.note.trim() ? `${named(item)} (${item.note.trim()})` : named(item)).join(", ")}.`);
    }
    lines.push(carried.length > 0 ? `Carrying: ${carried.map(named).join(", ")}.` : `Carrying: nothing${equipped.length ? " else" : ""}.`);
    return lines;
  }
  function priceList(guide) {
    return guide.split("\n").map((line) => line.trim().replace(/\s*[:=–—-]\s*(?=[\d.,]+\s*\S*$)/, " ")).filter((line) => line !== "").join(", ");
  }
  function itemIds() {
    return idList(INV.items);
  }

  // src/state/party.ts
  var PARTY = {
    share: "tap.party.share",
    /** The member ids, in the order shown. */
    members: "tap.party.members",
    /** What the AI sees, for the tab's preview. */
    preview: "tap.party.preview",
    member: (id, field) => `tap.party.member.${id}.${field}`
  };
  var STATUS_PRESETS = ["Healthy", "Wounded", "Exhausted", "Unconscious"];
  var ATTITUDE_PRESETS = ["Hostile", "Wary", "Neutral", "Friendly", "Loyal"];
  var MEMBER_FIELDS = ["name", "role", "status", "attitude", "notes", "present"];
  var NEW_MEMBER = {
    name: "",
    role: "",
    status: "Healthy",
    attitude: "Neutral",
    notes: "",
    present: true
  };
  async function initParty() {
    await api.v1.storyStorage.setIfAbsent(PARTY.share, true);
    await api.v1.storyStorage.setIfAbsent(PARTY.members, []);
  }
  async function readParty() {
    const s = api.v1.storyStorage;
    const members = await Promise.all(
      (await idList(PARTY.members)).map(async (id) => ({
        id,
        name: text(await s.get(PARTY.member(id, "name"))),
        role: text(await s.get(PARTY.member(id, "role"))),
        status: text(await s.get(PARTY.member(id, "status"))),
        attitude: text(await s.get(PARTY.member(id, "attitude"))),
        notes: text(await s.get(PARTY.member(id, "notes"))),
        present: await s.get(PARTY.member(id, "present")) !== false
      }))
    );
    return { share: await s.get(PARTY.share) !== false, members };
  }
  async function addMember() {
    const id = api.v1.uuid();
    const s = api.v1.storyStorage;
    for (const field of MEMBER_FIELDS) await s.set(PARTY.member(id, field), NEW_MEMBER[field]);
    await s.set(PARTY.members, [...await idList(PARTY.members), id]);
    return id;
  }
  async function removeMember(id) {
    const s = api.v1.storyStorage;
    await s.set(PARTY.members, (await idList(PARTY.members)).filter((other) => other !== id));
    for (const field of MEMBER_FIELDS) await s.remove(PARTY.member(id, field));
  }
  function moveMember(id, delta) {
    return moveInList(PARTY.members, id, delta);
  }
  function partyLines(party) {
    if (!party.share) return [];
    return party.members.filter((member) => member.present && member.name.trim() !== "").map((member) => {
      const role = member.role.trim();
      const parts = [`Companion: ${member.name.trim()}${role ? `, ${role}` : ""}.`];
      if (member.status.trim()) parts.push(`Status: ${sentence(member.status)}`);
      if (member.attitude.trim()) parts.push(`Attitude toward you: ${sentence(member.attitude)}`);
      const notes = member.notes.split("\n").filter((line) => line.trim() !== "").map(sentence);
      if (notes.length > 0) parts.push(`Notes: ${notes.join(" ")}`);
      return parts.join(" ");
    });
  }
  function sentence(value) {
    const trimmed = value.trim();
    return /[.!?…]$/.test(trimmed) ? trimmed : `${trimmed}.`;
  }

  // src/state/player.ts
  var PLAYER = {
    share: "tap.player.share",
    /** What the AI sees, for the tab's preview. */
    preview: "tap.player.preview",
    field: (field) => `tap.player.${field}`
  };
  var PRONOUN_PRESETS = ["he/him", "she/her", "they/them"];
  var FIELDS = ["name", "pronouns", "role", "appearance", "status", "abilities", "notes"];
  async function initPlayer() {
    const s = api.v1.storyStorage;
    await s.setIfAbsent(PLAYER.share, true);
    for (const field of FIELDS) await s.setIfAbsent(PLAYER.field(field), field === "status" ? "Healthy" : "");
  }
  async function readPlayer() {
    const s = api.v1.storyStorage;
    const player = { share: await s.get(PLAYER.share) !== false };
    for (const field of FIELDS) player[field] = text(await s.get(PLAYER.field(field))).trim();
    return player;
  }
  function playerLines(player) {
    if (!player.share) return [];
    const { name, pronouns, role, appearance, status, abilities, notes } = player;
    if (![name, role, appearance, abilities, notes].some((value) => value !== "")) return [];
    const who = name ? pronouns ? `${name} (${pronouns})` : name : pronouns ? `pronouns ${pronouns}` : "";
    const head = [who, role].filter(Boolean).join(", ");
    const parts = [head ? `The protagonist ("you"): ${head}.` : 'The protagonist ("you").'];
    if (appearance) parts.push(`Appearance: ${sentences(appearance)}`);
    if (status) parts.push(`Status: ${sentences(status)}`);
    if (abilities) parts.push(`Skills and abilities: ${sentences(abilities)}`);
    if (notes) parts.push(`Notes: ${sentences(notes)}`);
    return [parts.join(" ")];
  }
  function sentences(value) {
    return value.split("\n").map((line) => line.trim()).filter((line) => line !== "").map((line) => /[.!?…]$/.test(line) ? line : `${line}.`).join(" ");
  }

  // src/state/setting.ts
  var SETTING = {
    share: "tap.setting.share",
    canon: "tap.setting.canon",
    /** What the AI sees, for the tab's preview. */
    preview: "tap.setting.preview",
    field: (field) => `tap.setting.${field}`
  };
  var TEXT_FIELDS = ["world", "location", "time", "notes"];
  async function initSetting() {
    const s = api.v1.storyStorage;
    await s.setIfAbsent(SETTING.share, true);
    await s.setIfAbsent(SETTING.canon, true);
    for (const field of TEXT_FIELDS) await s.setIfAbsent(SETTING.field(field), "");
  }
  async function readSetting() {
    const s = api.v1.storyStorage;
    return {
      share: await s.get(SETTING.share) !== false,
      world: text(await s.get(SETTING.field("world"))).trim(),
      location: text(await s.get(SETTING.field("location"))).trim(),
      time: text(await s.get(SETTING.field("time"))).trim(),
      canon: await s.get(SETTING.canon) !== false,
      notes: text(await s.get(SETTING.field("notes"))).trim()
    };
  }
  function settingLines(setting) {
    if (!setting.share) return [];
    const { world, location, time, canon, notes } = setting;
    if (![world, location, time, notes].some((value) => value !== "")) return [];
    const parts = [];
    if (world) parts.push(`Setting: ${sentences2(world)}`);
    if (location) parts.push(`Current location: ${sentences2(location)}`);
    if (time) parts.push(`Time: ${sentences2(time)}`);
    if (world && canon) {
      parts.push(
        `Keep to the established canon of this world (its lore, history, technology and characters)${notes ? ", except where the notes say otherwise" : ""}.`
      );
    }
    if (notes) parts.push(`Notes: ${sentences2(notes)}`);
    return [parts.join(" ")];
  }
  function sentences2(value) {
    return value.split("\n").map((line) => line.trim()).filter((line) => line !== "").map((line) => /[.!?…]$/.test(line) ? line : `${line}.`).join(" ");
  }

  // src/story/keys.ts
  var KEYS = {
    /** Story: whether the script is on for this story. */
    enabled: "sap.enabled",
    /** Account: keep the story in second person, present tense. */
    pov: "sap.pov",
    /** Account: check each reply for slips out of second person, present tense. */
    check: "sap.check",
    /** Account: whether the writing guide is added to the system prompt, and its text. */
    useGuide: "sap.useGuide",
    guide: "sap.guide",
    /** Account: the default guide the script last stored, to tell an untouched guide from an edited one. */
    guideDefault: "sap.guideDefault",
    /** Story: summary and full details of the last checked reply. */
    lastReplyStatus: "sap.lastReply.status",
    lastReplyDetails: "sap.lastReply.details"
  };
  var STORY_IDS = {
    settingsPanel: "sap-settings"
  };

  // src/state/gameState.ts
  function gameStateBlock(lines) {
    if (lines.length === 0) return void 0;
    return ["Game state (keep the story consistent with it):", ...lines.map((line) => `- ${line}`)].join("\n");
  }

  // src/ui/common.ts
  var MUTED = { opacity: 0.7, fontSize: "0.85em" };
  function debounced(run, delay = 300) {
    let pending = false;
    return () => {
      if (pending) return;
      pending = true;
      api.v1.timers.setTimeout(() => {
        pending = false;
        run().catch(logError);
      }, delay).catch(logError);
    };
  }
  function previewSection(key) {
    return {
      type: "collapsibleSection",
      title: "What the AI sees",
      iconId: "eye",
      initialCollapsed: true,
      content: [{ type: "text", text: `{{story:${key}}}`, style: { whiteSpace: "pre-wrap", fontSize: "0.9em" } }]
    };
  }
  function forTemplate(value) {
    return value.replace(/\{\{/g, "{ {");
  }

  // src/ui/inventoryPanel.ts
  var schedulePreview = debounced(() => updatePreview());
  async function inventoryPanel(rebuild) {
    const inv = await readInventory();
    updatePreview(inv).catch(logError);
    const edited = () => schedulePreview();
    return {
      type: "scriptPanel",
      id: IDS.inventoryPanel,
      name: "Inventory",
      iconId: "package",
      content: [
        {
          type: "checkboxInput",
          label: "Tell the AI about my inventory",
          storageKey: `story:${INV.share}`,
          onChange: edited
        },
        moneySection(edited),
        itemsSection(inv, rebuild, edited),
        previewSection(INV.preview)
      ]
    };
  }
  function moneySection(edited) {
    return {
      type: "box",
      content: [
        { type: "text", markdown: true, text: "**Money**" },
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "numberInput", label: "Amount", storageKey: `story:${INV.amount}`, onChange: edited, style: { width: "7em" } },
            stepButton("−", INV.amount, -1, edited),
            stepButton("+", INV.amount, 1, edited),
            {
              type: "textInput",
              label: "Currency",
              placeholder: "gold",
              storageKey: `story:${INV.currency}`,
              onChange: edited,
              style: { width: "12em" }
            }
          ]
        },
        {
          type: "collapsibleSection",
          title: "Price guide",
          iconId: "tag",
          initialCollapsed: true,
          content: [
            {
              type: "text",
              text: 'Typical prices in your currency, one per line, like "a hot meal: 2". The AI is told to keep every price in the story in line with these, so it knows what your money is worth.',
              style: MUTED
            },
            { type: "multilineTextInput", storageKey: `story:${INV.prices}`, onChange: edited }
          ]
        }
      ]
    };
  }
  function itemsSection(inv, rebuild, edited) {
    return {
      type: "box",
      content: [
        { type: "text", markdown: true, text: "**Items**" },
        ...inv.items.length > 0 ? inv.items.map((item) => itemPart(item, rebuild, edited)) : [{ type: "text", text: "Nothing yet.", style: MUTED }],
        {
          type: "button",
          text: "Add item",
          iconId: "plus",
          disabledWhileCallbackRunning: true,
          callback: () => addItem().then(rebuild).catch(logError)
        }
      ]
    };
  }
  function itemPart(item, rebuild, edited) {
    const key = (field) => `story:${INV.item(item.id, field)}`;
    return {
      type: "column",
      id: `tap-item-${item.id}`,
      style: { gap: "4px", paddingBottom: "8px" },
      content: [
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Item", placeholder: "Item name", storageKey: key("name"), onChange: edited, style: { flex: "1 1 10em" } },
            { type: "numberInput", label: "Qty", storageKey: key("quantity"), onChange: edited, style: { width: "5em" } },
            stepButton("−", INV.item(item.id, "quantity"), -1, edited, 1),
            stepButton("+", INV.item(item.id, "quantity"), 1, edited, 1),
            { type: "checkboxInput", label: "Equipped", storageKey: key("equipped"), onChange: edited },
            {
              type: "button",
              text: "Remove",
              iconId: "trash-2",
              callback: () => removeItem(item.id).then(rebuild).catch(logError)
            }
          ]
        },
        {
          type: "textInput",
          placeholder: 'Note for the AI while equipped (optional), e.g. "notched blade"',
          storageKey: key("note"),
          onChange: edited
        }
      ]
    };
  }
  function stepButton(text2, key, delta, edited, fallback = 0) {
    return {
      type: "button",
      text: text2,
      callback: () => adjustCount(key, delta, fallback).then(edited).catch(logError)
    };
  }
  async function updatePreview(inv) {
    const current = inv ?? await readInventory();
    const block = gameStateBlock(inventoryLines(current));
    const text2 = !current.share ? "Nothing: sending the inventory is turned off above." : block ?? "Nothing yet. Add money or an item, and it will be sent with every turn.";
    await api.v1.storyStorage.set(INV.preview, forTemplate(text2));
  }

  // src/ui/panelSet.ts
  function panelSet(builders, ids) {
    let visible = false;
    const build = async () => {
      const panels2 = [];
      for (const builder of builders) panels2.push(await builder(rebuild));
      return panels2;
    };
    async function rebuild() {
      if (visible) await api.v1.ui.update(await build());
    }
    return {
      async setVisible(show) {
        if (show === visible) return;
        if (show) await api.v1.ui.update(await build());
        else await api.v1.ui.remove(ids);
        visible = show;
      }
    };
  }

  // src/ui/partyPanel.ts
  var schedulePreview2 = debounced(() => updatePartyPreview());
  var TEXT_ADVENTURE_PARTY_NOTE = 'Companions speak and act for themselves; only your own character is protected. Untick "In party" for someone who is away: they stay listed but are not sent.';
  async function partyPanel(rebuild, note = TEXT_ADVENTURE_PARTY_NOTE) {
    const party = await readParty();
    updatePartyPreview(party).catch(logError);
    const edited = () => schedulePreview2();
    return {
      type: "scriptPanel",
      id: IDS.partyPanel,
      name: "Party",
      iconId: "users",
      content: [
        {
          type: "checkboxInput",
          label: "Tell the AI about my party",
          storageKey: `story:${PARTY.share}`,
          onChange: edited
        },
        { type: "text", text: note, style: MUTED },
        ...party.members.length > 0 ? party.members.map((member, index) => memberPart(member, index, party.members.length, rebuild, edited)) : [{ type: "text", text: "No companions yet.", style: MUTED }],
        {
          type: "button",
          text: "Add companion",
          iconId: "user-plus",
          disabledWhileCallbackRunning: true,
          callback: () => addMember().then(rebuild).catch(logError)
        },
        previewSection(PARTY.preview)
      ]
    };
  }
  function memberPart(member, index, total, rebuild, edited) {
    const key = (field) => PARTY.member(member.id, field);
    const presets = (field, words) => words.map((word) => ({
      type: "button",
      text: word,
      callback: () => api.v1.storyStorage.set(key(field), word).then(edited).catch(logError)
    }));
    return {
      type: "box",
      id: `tap-member-${member.id}`,
      content: [
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Name", placeholder: "Name", storageKey: `story:${key("name")}`, onChange: edited, style: { width: "10em" } },
            {
              type: "textInput",
              label: "Who they are",
              placeholder: "elf ranger, your guide",
              storageKey: `story:${key("role")}`,
              onChange: edited,
              style: { flex: "1 1 12em" }
            },
            { type: "checkboxInput", label: "In party", storageKey: `story:${key("present")}`, onChange: edited }
          ]
        },
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Status", storageKey: `story:${key("status")}`, onChange: edited, style: { width: "12em" } },
            ...presets("status", STATUS_PRESETS)
          ]
        },
        {
          type: "row",
          wrap: true,
          spacing: "start",
          alignment: "end",
          content: [
            { type: "textInput", label: "Attitude toward you", storageKey: `story:${key("attitude")}`, onChange: edited, style: { width: "12em" } },
            ...presets("attitude", ATTITUDE_PRESETS)
          ]
        },
        {
          type: "textInput",
          label: "Notes",
          placeholder: "Personality, goals, secrets (optional)",
          storageKey: `story:${key("notes")}`,
          onChange: edited
        },
        {
          type: "row",
          spacing: "start",
          content: [
            {
              type: "button",
              text: "Move up",
              iconId: "arrow-up",
              disabled: index === 0,
              callback: () => moveMember(member.id, -1).then(rebuild).catch(logError)
            },
            {
              type: "button",
              text: "Move down",
              iconId: "arrow-down",
              disabled: index === total - 1,
              callback: () => moveMember(member.id, 1).then(rebuild).catch(logError)
            },
            {
              type: "button",
              text: "Remove",
              iconId: "trash-2",
              callback: () => removeMember(member.id).then(rebuild).catch(logError)
            }
          ]
        }
      ]
    };
  }
  async function updatePartyPreview(party) {
    const current = party ?? await readParty();
    const block = gameStateBlock(partyLines(current));
    const text2 = !current.share ? "Nothing: sending the party is turned off above." : block ?? "Nothing yet. Add a companion with a name, and they will be sent with every turn.";
    await api.v1.storyStorage.set(PARTY.preview, forTemplate(text2));
  }

  // src/ui/playerPanel.ts
  var schedulePreview3 = debounced(() => updatePlayerPreview());
  async function playerPanel() {
    updatePlayerPreview().catch(logError);
    const edited = () => schedulePreview3();
    const key = (field) => `story:${PLAYER.field(field)}`;
    const presets = (field, words) => words.map((word) => ({
